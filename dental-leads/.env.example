# Secrets das Edge Functions (Supabase → Project Settings → Edge Functions →
# Secrets). NUNCA comitar valores reais. NUNCA usar qualquer chave daqui no
# frontend — o painel usa apenas SUPABASE_URL + anon key em web/config.js.
#
#   supabase secrets set --env-file .env

# --- Supabase (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetados
#     automaticamente nas Edge Functions; listados aqui só para referência) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Evolution API (instância que JÁ existe — não instalar outra) ---
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_SEND_DELAY_MS=1500
EVOLUTION_TIMEOUT_MS=15000

# --- Webhook ---
# Senha que a Evolution envia no header x-webhook-secret (ou ?secret= na URL).
WEBHOOK_SECRET=
# Espelhamento para o webhook do CRM antigo. Vazio = desligado.
# Só preencha depois de ler docs/evolution-webhook.md.
LEGACY_WEBHOOK_URL=
LEGACY_WEBHOOK_TIMEOUT_MS=4000

# --- Worker / motor de turno ---
WORKER_SECRET=
# Turnos rodam em paralelo e gastam tempo de parede (delay + IA + envio):
# lote pequeno mantém a invocação dentro do orçamento da plataforma.
WORKER_BATCH_SIZE=3
WORKER_MAX_ATTEMPTS=4
WORKER_BACKOFF_BASE_SECONDS=120
TAKEOVER_GRACE_SECONDS=120
# Lock por lead: precisa ser maior que o pior turno possível (é renovado por
# heartbeat durante o processamento).
JOB_LEASE_SECONDS=120
# Teto de espera do worker acordado pelo webhook antes de tentar pegar o turno.
WORKER_MAX_WAIT_MS=9000
WORKER_WALL_BUDGET_MS=60000

# --- Rajada (debounce) e ritmo humano ---
# Silêncio necessário para considerar que o lead terminou de escrever.
MESSAGE_DEBOUNCE_SECONDS=5
# Teto contado desde o INÍCIO da rajada, nunca reiniciado por mensagem nova:
# quem digita sem parar ainda é respondido.
DEBOUNCE_MAX_WAIT_SECONDS=30
RESPONSE_DELAY_MIN_MS=2000
RESPONSE_DELAY_MAX_MS=5000
OUTBOUND_BUBBLE_DELAY_MIN_MS=1500
OUTBOUND_BUBBLE_DELAY_MAX_MS=3500
MAX_BUBBLES=3
OUTBOX_DEDUPE_SECONDS=120
# Margem estimada por bolha (POST + idas ao banco), usada só para decidir,
# ANTES da 1a bolha, se o orçamento de parede restante comporta a sequência
# inteira (yield preventivo). Não é o timeout real do envio.
BUBBLE_SEND_MARGIN_MS=5000

# --- IA (trocar de provedor/modelo é trocar estas variáveis) ---
# AI_PROVIDER: anthropic | openai (openai cobre qualquer API compatível:
# OpenAI, DeepSeek, Groq, OpenRouter — nesse caso preencha AI_BASE_URL)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.4
AI_MIN_CONFIDENCE=0.6
AI_CONTEXT_MESSAGES=8
AI_MAX_REPLY_CHARS=600

# --- Rate limit (por TURNO e por lead, nunca por bolha) ---
RATE_LIMIT_MIN_INTERVAL=20
RATE_LIMIT_HOURLY=8
RATE_LIMIT_DAILY=30

# --- Clínica (entra no prompt; a IA não sabe nada além disto) ---
CLINIC_NAME=
CLINIC_CITY=
CLINIC_ADDRESS=
CLINIC_HOURS=
CLINIC_TREATMENTS=Invisalign, aparelho ortodôntico, clareamento, lentes e facetas, implante, limpeza
CLINIC_HANDOFF_MESSAGE=Vou pedir para alguém da nossa equipe te responder por aqui, tá? 🙏
