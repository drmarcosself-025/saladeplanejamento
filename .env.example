# Copie este arquivo para ".env" (sem o ".example") e preencha os valores reais.
# NUNCA envie o arquivo ".env" para o GitHub - ele fica de fora por causa do .gitignore.

# ---- Meta (WhatsApp Cloud API) ----

# Chave secreta do seu App na Meta (Meta for Developers > seu app > Configuracoes basicas > Chave secreta do aplicativo).
# Usada para conferir que os webhooks recebidos realmente vieram da Meta (assinatura X-Hub-Signature-256).
META_APP_SECRET=

# Token de acesso do WhatsApp (Meta for Developers > seu app > WhatsApp > Configuracao da API).
# Comece com o token temporario de 24h para testar; depois troque por um token permanente do System User.
META_ACCESS_TOKEN=

# ID do numero de telefone do WhatsApp Business (Meta for Developers > seu app > WhatsApp > Configuracao da API).
# E um numero de identificacao interno da Meta, nao e o numero de telefone em si.
META_PHONE_NUMBER_ID=

# Token que voce mesmo inventa (uma senha qualquer, ex: "abacaxi-123") e cola no painel da Meta
# na hora de configurar o Webhook ("Verify Token"). Serve so para a Meta confirmar que o
# webhook e seu na primeira vez que ele e configurado.
META_VERIFY_TOKEN=

# ---- Supabase ----

# URL do seu projeto Supabase (Supabase > Project Settings > API > Project URL).
SUPABASE_URL=

# Chave "service_role" do Supabase (Supabase > Project Settings > API > service_role key).
# ATENCAO: essa chave tem acesso total ao banco, ignorando o Row Level Security.
# So deve existir no servidor (Railway), nunca em paginas HTML ou no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Protecao da rota de envio manual ----

# Uma senha qualquer, inventada por voce, para proteger a rota /enviar-template.
# Sem ela, qualquer pessoa que descobrisse o endereco do servidor poderia mandar mensagens
# usando seu numero. Voce vai digitar essa mesma senha na paginha HTML de teste.
ENVIAR_TEMPLATE_TOKEN=
